# Порт HTTP-сервера
PORT=4000

# Разрешённый источник для CORS (адрес фронтенда). * — разрешить все.
CORS_ORIGIN=http://localhost:5173

# Окружение: development | production
NODE_ENV=development

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auditrank

# Секрет для подписи JWT (в продакшене задайте длинную случайную строку!)
JWT_SECRET=dev-secret-change-me
# Срок жизни токена (например: 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Учётка администратора, создаётся при первом запуске, если пользователей ещё нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Базовый адрес фронтенда — на него ведёт ссылка сброса пароля из письма
APP_URL=http://localhost:5173
# Сколько минут живёт ссылка для сброса пароля
RESET_TOKEN_TTL_MINUTES=30

# Отправка писем через Resend (https://resend.com).
# Если ключ пуст — письма не уходят, а ссылка сброса печатается в консоль бэкенда.
RESEND_API_KEY=
# Адрес отправителя (для теста сгодится onboarding@resend.dev; для своего домена — подтвердите его в Resend)
MAIL_FROM=AuditRank <onboarding@resend.dev>
